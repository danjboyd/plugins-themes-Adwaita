+/* The shadow margin of windows the gui decorates (GSBackWindowShadows):
+ * a transparent margin round the frame with a 32-bit visual,
+ * _GTK_FRAME_EXTENTS telling the window manager where the window is, an
+ * input shape of the visible part plus a resize band, no margin while the
+ * window manager has the window maximized or while no compositing manager
+ * runs, and none at all for a window manager that doesn't know
+ * _GTK_FRAME_EXTENTS.  Also the Motif hints of such windows, and the alpha
+ * channel of borderless windows (GSBackBorderlessWindowAlpha).
+ *
+ * The test forks a window manager that maps windows, decorates nothing and
+ * lists _GTK_FRAME_EXTENTS in _NET_SUPPORTED, and a compositing manager that
+ * only owns the _NET_WM_CM_S0 selection; stopping it is how the compositing
+ * manager goes away.  It needs a display with neither (a private Xvfb).
+ * Popovers (GSBackPopoverShadows: a borderless window marked with
+ * NSUtilityWindowMask) get a smaller margin of their own.
+ */
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+#include "config.h"
+
+#if defined(BUILD_SERVER) && defined(SERVER_x11) && BUILD_SERVER == SERVER_x11 \
+  && defined(HAVE_XSHAPE) && defined(XRENDER)
+
+#import <AppKit/AppKit.h>
+#import <GNUstepGUI/GSDisplayServer.h>
+#include <X11/Xlib.h>
+#include <X11/Xatom.h>
+#include <X11/extensions/shape.h>
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int
+ignoreErrors(Display *d, XErrorEvent *e)
+{
+  return 0;
+}
+
+/* Announces itself, lists what it supports, and maps what asks to be. */
+static void
+windowManagerRun(void)
+{
+  Display	*dpy = XOpenDisplay(NULL);
+  Window	root;
+  Window	check;
+  Atom		netCheck;
+  Atom		supported[4];
+
+  if (dpy == NULL)
+    {
+      _exit(1);
+    }
+  XSetErrorHandler(ignoreErrors);
+  root = DefaultRootWindow(dpy);
+  netCheck = XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False);
+  check = XCreateSimpleWindow(dpy, root, -100, -100, 1, 1, 0, 0, 0);
+  XChangeProperty(dpy, check, netCheck, XA_WINDOW, 32, PropModeReplace,
+    (unsigned char *)&check, 1);
+  supported[0] = netCheck;
+  supported[1] = XInternAtom(dpy, "_NET_WM_STATE", False);
+  supported[2] = XInternAtom(dpy, "_GTK_FRAME_EXTENTS", False);
+  supported[3] = XInternAtom(dpy, "_NET_FRAME_EXTENTS", False);
+  XChangeProperty(dpy, root, XInternAtom(dpy, "_NET_SUPPORTED", False),
+    XA_ATOM, 32, PropModeReplace, (unsigned char *)supported, 4);
+  XSelectInput(dpy, root, SubstructureRedirectMask | SubstructureNotifyMask);
+  XChangeProperty(dpy, root, netCheck, XA_WINDOW, 32, PropModeReplace,
+    (unsigned char *)&check, 1);
+  XFlush(dpy);
+  for (;;)
+    {
+      XEvent	e;
+
+      XNextEvent(dpy, &e);
+      if (e.type == MapRequest)
+	{
+	  XMapWindow(dpy, e.xmaprequest.window);
+	}
+      else if (e.type == ConfigureRequest)
+	{
+	  XWindowChanges	c;
+
+	  c.x = e.xconfigurerequest.x;
+	  c.y = e.xconfigurerequest.y;
+	  c.width = e.xconfigurerequest.width;
+	  c.height = e.xconfigurerequest.height;
+	  XConfigureWindow(dpy, e.xconfigurerequest.window,
+	    e.xconfigurerequest.value_mask & (CWX | CWY | CWWidth | CWHeight),
+	    &c);
+	}
+      XFlush(dpy);
+    }
+}
+
+/* Owns _NET_WM_CM_S0 until killed. */
+static void
+compositorRun(void)
+{
+  Display	*dpy = XOpenDisplay(NULL);
+  Window	owner;
+
+  if (dpy == NULL)
+    {
+      _exit(1);
+    }
+  owner = XCreateSimpleWindow(dpy, DefaultRootWindow(dpy), -100, -100,
+    1, 1, 0, 0, 0);
+  XSetSelectionOwner(dpy, XInternAtom(dpy, "_NET_WM_CM_S0", False), owner,
+    CurrentTime);
+  XFlush(dpy);
+  for (;;)
+    {
+      pause();
+    }
+}
+
+static pid_t
+startChild(void (*run)(void))
+{
+  pid_t	pid = fork();
+
+  if (pid == 0)
+    {
+      run();
+      _exit(0);
+    }
+  return pid;
+}
+
+static void
+stopChild(pid_t pid)
+{
+  if (pid > 0)
+    {
+      kill(pid, SIGKILL);
+      waitpid(pid, NULL, 0);
+    }
+}
+
+/* Waits for a root property, or for a selection to be owned or not. */
+static BOOL
+waitFor(Display *dpy, Atom selection, BOOL owned, Atom rootProperty)
+{
+  unsigned	i;
+
+  for (i = 0; i < 100; i++)
+    {
+      if (rootProperty != None)
+	{
+	  Atom		type;
+	  int		format;
+	  unsigned long	n, after;
+	  unsigned char	*data = NULL;
+
+	  if (XGetWindowProperty(dpy, DefaultRootWindow(dpy), rootProperty,
+	      0, 1, False, AnyPropertyType, &type, &format, &n, &after, &data)
+	    == Success && data != NULL)
+	    {
+	      XFree(data);
+	      if (n > 0)
+		{
+		  return YES;
+		}
+	    }
+	}
+      else if ((XGetSelectionOwner(dpy, selection) != None) == owned)
+	{
+	  return YES;
+	}
+      usleep(50000);
+    }
+  return NO;
+}
+
+/* Lets the backend handle what the X server sent it. */
+static void
+spin(void)
+{
+  [[NSRunLoop currentRunLoop]
+    runUntilDate: [NSDate dateWithTimeIntervalSinceNow: 0.4]];
+}
+
+/* The window's _GTK_FRAME_EXTENTS as "l r t b", or "none". */
+static NSString *
+frameExtents(Display *dpy, Window w)
+{
+  Atom		type;
+  int		format;
+  unsigned long	n, after;
+  unsigned char	*data = NULL;
+  NSString	*s = @"none";
+
+  XSync(dpy, False);
+  if (XGetWindowProperty(dpy, w, XInternAtom(dpy, "_GTK_FRAME_EXTENTS", False),
+      0, 4, False, XA_CARDINAL, &type, &format, &n, &after, &data) == Success
+    && data != NULL)
+    {
+      unsigned long *v = (unsigned long *)data;
+
+      if (n == 4)
+	{
+	  s = [NSString stringWithFormat: @"%lu %lu %lu %lu",
+	    v[0], v[1], v[2], v[3]];
+	}
+      XFree(data);
+    }
+  return s;
+}
+
+static int
+depthOf(Display *dpy, Window w)
+{
+  XWindowAttributes	a;
+
+  return XGetWindowAttributes(dpy, w, &a) ? a.depth : 0;
+}
+
+static NSSize
+sizeOf(Display *dpy, Window w)
+{
+  XWindowAttributes	a;
+
+  XSync(dpy, False);
+  return XGetWindowAttributes(dpy, w, &a)
+    ? NSMakeSize(a.width, a.height) : NSZeroSize;
+}
+
+/* The input shape as one rectangle, or an empty rectangle when it is not
+ * one. */
+static NSRect
+inputShape(Display *dpy, Window w)
+{
+  int		count = 0;
+  int		ordering;
+  XRectangle	*r;
+  NSRect	result = NSZeroRect;
+
+  XSync(dpy, False);
+  r = XShapeGetRectangles(dpy, w, ShapeInput, &count, &ordering);
+  if (r != NULL)
+    {
+      if (count == 1)
+	{
+	  result = NSMakeRect(r[0].x, r[0].y, r[0].width, r[0].height);
+	}
+      XFree(r);
+    }
+  return result;
+}
+
+static void
+setMaximized(Display *dpy, Window w, BOOL maximized)
+{
+  Atom	state[2];
+
+  state[0] = XInternAtom(dpy, "_NET_WM_STATE_MAXIMIZED_VERT", False);
+  state[1] = XInternAtom(dpy, "_NET_WM_STATE_MAXIMIZED_HORZ", False);
+  XChangeProperty(dpy, w, XInternAtom(dpy, "_NET_WM_STATE", False), XA_ATOM,
+    32, PropModeReplace, (unsigned char *)state, maximized ? 2 : 0);
+  XFlush(dpy);
+}
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("shadow margin")
+
+  extern void	initialize_gnustep_backend(void);
+  NSUserDefaults	*defs = [NSUserDefaults standardUserDefaults];
+  NSUInteger		styled = NSTitledWindowMask | NSClosableWindowMask
+    | NSMiniaturizableWindowMask | NSResizableWindowMask;
+  GSDisplayServer	*srv = nil;
+  Display		*dpy;
+  Atom			cm;
+  pid_t			wm;
+  pid_t			compositor;
+  int			win;
+  Window		xwin;
+  NSRect		shape;
+  NSSize		size;
+
+  if (getenv("DISPLAY") == NULL || *getenv("DISPLAY") == '\0')
+    {
+      SKIP("no window server available")
+    }
+  dpy = XOpenDisplay(NULL);
+  if (dpy == NULL)
+    {
+      SKIP("no window server available")
+    }
+  XSetErrorHandler(ignoreErrors);
+  cm = XInternAtom(dpy, "_NET_WM_CM_S0", False);
+  if (XGetSelectionOwner(dpy, cm) != None)
+    {
+      SKIP("the display has a compositing manager of its own")
+    }
+
+  wm = startChild(windowManagerRun);
+  compositor = startChild(compositorRun);
+  if (!waitFor(dpy, None, YES,
+	XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False))
+    || !waitFor(dpy, cm, YES, None))
+    {
+      stopChild(wm);
+      stopChild(compositor);
+      SKIP("the test window or compositing manager did not start")
+    }
+
+  [defs setBool: NO forKey: @"GSBackHandlesWindowDecorations"];
+  [defs setBool: YES forKey: @"GSIgnoreRootOffsets"];
+  NS_DURING
+    {
+      initialize_gnustep_backend();
+      srv = [GSDisplayServer serverWithAttributes: nil];
+    }
+  NS_HANDLER
+    {
+      stopChild(wm);
+      stopChild(compositor);
+      SKIP("It looks like the GNUstep backend is not installed")
+    }
+  NS_ENDHANDLER
+  [GSDisplayServer setCurrentServer: srv];
+
+  /* Without GSBackWindowShadows nothing changes. */
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreBuffered : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"]
+    && NSEqualSizes(sizeOf(dpy, xwin), NSMakeSize(400, 300)),
+    "without GSBackWindowShadows a window has no margin");
+  {
+    Atom		type;
+    int			format;
+    unsigned long	n, after;
+    unsigned char	*data = NULL;
+    BOOL		movable = NO;
+
+    if (XGetWindowProperty(dpy, xwin,
+	XInternAtom(dpy, "_MOTIF_WM_HINTS", False), 0, 5, False,
+	AnyPropertyType, &type, &format, &n, &after, &data) == Success
+      && data != NULL)
+      {
+	unsigned long *hints = (unsigned long *)data;
+
+	/* flags (functions, decorations), functions, decorations */
+	movable = n >= 3 && (hints[0] & 1) && (hints[1] & 4) && hints[2] == 0;
+	XFree(data);
+      }
+    PASS(movable, "a window the gui decorates asks for no decorations but"
+      " lets the window manager move it");
+  }
+  [srv termwindow: win];
+
+  [defs setBool: YES forKey: @"GSBackWindowShadows"];
+  [defs setInteger: 15 forKey: @"GSBackWindowCornerRadius"];
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreBuffered : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  [srv orderwindow: NSWindowAbove : 0 : win];
+  spin();
+  PASS(depthOf(dpy, xwin) == 32, "a window with a margin has an alpha channel");
+  PASS_EQUAL(frameExtents(dpy, xwin), @"30 30 24 36",
+    "_GTK_FRAME_EXTENTS gives the margin");
+  PASS(NSEqualSizes(sizeOf(dpy, xwin), NSMakeSize(460, 360)),
+    "the X window is the frame plus the margin");
+  PASS(NSEqualRects(inputShape(dpy, xwin), NSMakeRect(18, 12, 424, 324)),
+    "a resizable window takes input in its frame and a 12 pixel band");
+
+  [srv placewindow: NSMakeRect(100, 100, 500, 350) : win];
+  spin();
+  shape = inputShape(dpy, xwin);
+  PASS(NSEqualRects(shape, NSMakeRect(18, 12, 524, 374)),
+    "the input shape follows a resize the program makes (%s)",
+    [NSStringFromRect(shape) UTF8String]);
+
+  setMaximized(dpy, xwin, YES);
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"0 0 0 0",
+    "a maximized window has no margin");
+  setMaximized(dpy, xwin, NO);
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"30 30 24 36",
+    "the margin comes back when the window is restored");
+
+  stopChild(compositor);
+  waitFor(dpy, cm, NO, None);
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"0 0 0 0",
+    "without a compositing manager the window has no margin");
+  compositor = startChild(compositorRun);
+  waitFor(dpy, cm, YES, None);
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"30 30 24 36",
+    "the margin comes back with a compositing manager");
+  [srv termwindow: win];
+
+  /* The margin, the corners and the band are in points: they grow with
+     the gui's scale factor. */
+  [defs setFloat: 2.0 forKey: @"GSScaleFactor"];
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreBuffered : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  [srv orderwindow: NSWindowAbove : 0 : win];
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"60 60 48 72",
+    "with GSScaleFactor 2 the margin is twice as wide");
+  shape = inputShape(dpy, xwin);
+  PASS(NSEqualRects(shape, NSMakeRect(36, 24, 448, 348)),
+    "with GSScaleFactor 2 the resize band is 24 pixels (%s)",
+    [NSStringFromRect(shape) UTF8String]);
+  setMaximized(dpy, xwin, YES);
+  spin();
+  setMaximized(dpy, xwin, NO);
+  spin();
+  PASS_EQUAL(frameExtents(dpy, xwin), @"60 60 48 72",
+    "with GSScaleFactor 2 the margin comes back twice as wide");
+  [srv termwindow: win];
+  [defs removeObjectForKey: @"GSScaleFactor"];
+
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreNonretained : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"],
+    "a non-retained window has no margin");
+  [srv termwindow: win];
+
+  win = [srv window: NSMakeRect(100, 100, 200, 100)
+		   : NSBackingStoreBuffered : NSBorderlessWindowMask : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS(depthOf(dpy, xwin) != 32 && [frameExtents(dpy, xwin) isEqual: @"none"],
+    "a borderless window has neither margin nor alpha channel by default");
+  [srv termwindow: win];
+  [defs setBool: YES forKey: @"GSBackBorderlessWindowAlpha"];
+  win = [srv window: NSMakeRect(100, 100, 200, 100)
+		   : NSBackingStoreBuffered : NSBorderlessWindowMask : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS(depthOf(dpy, xwin) == 32 && [frameExtents(dpy, xwin) isEqual: @"none"],
+    "with GSBackBorderlessWindowAlpha a borderless window has an alpha"
+    " channel and no margin");
+  [srv termwindow: win];
+
+  /* A popover (a borderless window marked with NSUtilityWindowMask, as the
+     Adwaita theme marks its menus): a popover's margin, and presses only
+     in its visible part (no resize band). */
+  win = [srv window: NSMakeRect(100, 100, 200, 100)
+		   : NSBackingStoreBuffered
+		   : NSBorderlessWindowMask | NSUtilityWindowMask : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"],
+    "without GSBackPopoverShadows a popover has no margin");
+  [srv termwindow: win];
+  [defs setBool: YES forKey: @"GSBackPopoverShadows"];
+  win = [srv window: NSMakeRect(100, 100, 200, 100)
+		   : NSBackingStoreBuffered
+		   : NSBorderlessWindowMask | NSUtilityWindowMask : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS(depthOf(dpy, xwin) == 32
+    && [frameExtents(dpy, xwin) isEqual: @"14 14 12 16"]
+    && NSEqualSizes(sizeOf(dpy, xwin), NSMakeSize(228, 128))
+    && NSEqualRects(inputShape(dpy, xwin), NSMakeRect(14, 12, 200, 100)),
+    "with GSBackPopoverShadows a popover has a popover's margin and takes"
+    " presses only in its visible part");
+  [srv termwindow: win];
+  win = [srv window: NSMakeRect(100, 100, 200, 100)
+		   : NSBackingStoreBuffered : NSBorderlessWindowMask : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"],
+    "a borderless window that isn't a popover has no margin");
+  [srv termwindow: win];
+  [defs setBool: NO forKey: @"GSBackPopoverShadows"];
+
+  stopChild(compositor);
+  waitFor(dpy, cm, NO, None);
+  spin();
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreBuffered : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"] && depthOf(dpy, xwin) != 32,
+    "a window made without a compositing manager has no margin");
+  [srv termwindow: win];
+  compositor = startChild(compositorRun);
+  waitFor(dpy, cm, YES, None);
+  spin();
+
+  /* A window manager that doesn't know _GTK_FRAME_EXTENTS. */
+  {
+    Atom	supported[2];
+
+    supported[0] = XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False);
+    supported[1] = XInternAtom(dpy, "_NET_WM_STATE", False);
+    XChangeProperty(dpy, DefaultRootWindow(dpy),
+      XInternAtom(dpy, "_NET_SUPPORTED", False), XA_ATOM, 32,
+      PropModeReplace, (unsigned char *)supported, 2);
+    XSync(dpy, False);
+  }
+  win = [srv window: NSMakeRect(100, 100, 400, 300)
+		   : NSBackingStoreBuffered : styled : 0];
+  xwin = (Window)[srv windowDevice: win];
+  size = sizeOf(dpy, xwin);
+  PASS([frameExtents(dpy, xwin) isEqual: @"none"]
+    && NSEqualSizes(size, NSMakeSize(400, 300)),
+    "under a window manager without _GTK_FRAME_EXTENTS there is no margin");
+  [srv termwindow: win];
+
+  stopChild(compositor);
+  stopChild(wm);
+  XCloseDisplay(dpy);
+
+  END_SET("shadow margin")
+
+  return 0;
+}
+
+#else
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("shadow margin")
+    SKIP("back is not built with the x11 server, XShape and XRender")
+  END_SET("shadow margin")
+  return 0;
+}
+
+#endif
diff --git a/Tests/x11/windowtype.m b/Tests/x11/windowtype.m
new file mode 100644
index 0000000..7b8a2b9
--- /dev/null
+++ b/Tests/x11/windowtype.m
@@ -0,0 +1,291 @@
+/* The _NET_WM_WINDOW_TYPE of the gui's windows, as GTK types its own:
+ * a tool tip is _TOOLTIP although its level is set before its window is
+ * registered (libs-gui#965), a context menu is _POPUP_MENU, a
+ * modal panel is _DIALOG, and any other window at the pop-up menu level
+ * stays _DIALOG.  The new types are followed by _DIALOG, what the window
+ * had before, for window managers that don't know them.
+ *
+ * The test forks a window manager that announces itself as an EWMH one
+ * and maps what asks to be.  It needs a display with no window manager of
+ * its own (a private Xvfb).
+ */
+#import <Foundation/Foundation.h>
+#import "Testing.h"
+#include "config.h"
+
+#if defined(BUILD_SERVER) && defined(SERVER_x11) && BUILD_SERVER == SERVER_x11
+
+#import <AppKit/AppKit.h>
+#import <GNUstepGUI/GSDisplayServer.h>
+#include <X11/Xlib.h>
+#include <X11/Xatom.h>
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/prctl.h>
+#endif
+
+static int
+ignoreErrors(Display *d, XErrorEvent *e)
+{
+  return 0;
+}
+
+/* Announces itself, lists the window types, and maps what asks to be. */
+static void
+windowManagerRun(void)
+{
+  Display	*dpy = XOpenDisplay(NULL);
+  Window	root;
+  Window	check;
+  Atom		netCheck;
+  Atom		supported[2];
+
+  if (dpy == NULL)
+    {
+      _exit(1);
+    }
+  XSetErrorHandler(ignoreErrors);
+  root = DefaultRootWindow(dpy);
+  netCheck = XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False);
+  check = XCreateSimpleWindow(dpy, root, -100, -100, 1, 1, 0, 0, 0);
+  XChangeProperty(dpy, check, netCheck, XA_WINDOW, 32, PropModeReplace,
+    (unsigned char *)&check, 1);
+  supported[0] = netCheck;
+  supported[1] = XInternAtom(dpy, "_NET_WM_WINDOW_TYPE", False);
+  XChangeProperty(dpy, root, XInternAtom(dpy, "_NET_SUPPORTED", False),
+    XA_ATOM, 32, PropModeReplace, (unsigned char *)supported, 2);
+  XSelectInput(dpy, root, SubstructureRedirectMask | SubstructureNotifyMask);
+  XChangeProperty(dpy, root, netCheck, XA_WINDOW, 32, PropModeReplace,
+    (unsigned char *)&check, 1);
+  XFlush(dpy);
+  for (;;)
+    {
+      XEvent	e;
+
+      XNextEvent(dpy, &e);
+      if (e.type == MapRequest)
+	{
+	  XMapWindow(dpy, e.xmaprequest.window);
+	}
+      XFlush(dpy);
+    }
+}
+
+static pid_t
+startWindowManager(void)
+{
+  pid_t	pid = fork();
+
+  if (pid == 0)
+    {
+#ifdef __linux__
+      /* Gone with the test, should it abort. */
+      prctl(PR_SET_PDEATHSIG, SIGKILL);
+#endif
+      windowManagerRun();
+      _exit(0);
+    }
+  return pid;
+}
+
+static void
+stopWindowManager(pid_t pid)
+{
+  if (pid > 0)
+    {
+      kill(pid, SIGKILL);
+      waitpid(pid, NULL, 0);
+    }
+}
+
+static BOOL
+waitForWindowManager(Display *dpy)
+{
+  Atom		netCheck = XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False);
+  unsigned	i;
+
+  for (i = 0; i < 100; i++)
+    {
+      Atom		type;
+      int		format;
+      unsigned long	n, after;
+      unsigned char	*data = NULL;
+
+      if (XGetWindowProperty(dpy, DefaultRootWindow(dpy), netCheck, 0, 1,
+	  False, XA_WINDOW, &type, &format, &n, &after, &data) == Success
+	&& data != NULL)
+	{
+	  XFree(data);
+	  if (n > 0)
+	    {
+	      return YES;
+	    }
+	}
+      usleep(50000);
+    }
+  return NO;
+}
+
+/* Lets the backend handle what the X server sent it. */
+static void
+spin(void)
+{
+  [[NSRunLoop currentRunLoop]
+    runUntilDate: [NSDate dateWithTimeIntervalSinceNow: 0.3]];
+}
+
+/* The window's _NET_WM_WINDOW_TYPE, in order of preference, each less its
+ * _NET_WM_WINDOW_TYPE_ prefix and separated by spaces, or "none". */
+static NSString *
+windowType(Display *dpy, NSWindow *window)
+{
+  Window	w = (Window)[GSCurrentServer() windowDevice: [window windowNumber]];
+  Atom		type;
+  int		format;
+  unsigned long	n, after, i;
+  unsigned char	*data = NULL;
+  NSMutableArray *names = [NSMutableArray array];
+
+  XSync(dpy, False);
+  if (XGetWindowProperty(dpy, w, XInternAtom(dpy, "_NET_WM_WINDOW_TYPE", False),
+      0, 8, False, XA_ATOM, &type, &format, &n, &after, &data) == Success
+    && data != NULL)
+    {
+      for (i = 0; i < n; i++)
+	{
+	  char	*name = XGetAtomName(dpy, ((Atom *)data)[i]);
+
+	  [names addObject: [[NSString stringWithUTF8String: name]
+	    substringFromIndex: strlen("_NET_WM_WINDOW_TYPE_")]];
+	  XFree(name);
+	}
+      XFree(data);
+    }
+  return [names count] > 0 ? [names componentsJoinedByString: @" "] : @"none";
+}
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("window types")
+
+  Display		*dpy;
+  pid_t			wm;
+  Class			toolTipClass;
+  NSPanel		*toolTip;
+  NSPanel		*modal;
+  NSWindow		*popUpLevel;
+  NSWindow		*menuWindow;
+
+  if (getenv("DISPLAY") == NULL || *getenv("DISPLAY") == '\0')
+    {
+      SKIP("no window server available")
+    }
+  dpy = XOpenDisplay(NULL);
+  if (dpy == NULL)
+    {
+      SKIP("no window server available")
+    }
+  XSetErrorHandler(ignoreErrors);
+  if (XGetSelectionOwner(dpy, XInternAtom(dpy, "WM_S0", False)) != None)
+    {
+      SKIP("the display has a window manager of its own")
+    }
+
+  wm = startWindowManager();
+  if (!waitForWindowManager(dpy))
+    {
+      stopWindowManager(wm);
+      SKIP("the test window manager did not start")
+    }
+
+  NS_DURING
+    {
+      [NSApplication sharedApplication];
+    }
+  NS_HANDLER
+    {
+      stopWindowManager(wm);
+      SKIP("It looks like the GNUstep backend is not installed")
+    }
+  NS_ENDHANDLER
+
+  /* As GSToolTips makes its window: deferred, its level set before it has
+     an X window, so the backend first sees the level with no window
+     registered for it. */
+  toolTipClass = NSClassFromString(@"GSTTPanel");
+  if (toolTipClass == Nil)
+    {
+      toolTipClass = [NSPanel class];
+    }
+  toolTip = [[toolTipClass alloc] initWithContentRect: NSMakeRect(0, 0, 100, 25)
+					    styleMask: NSBorderlessWindowMask
+					      backing: NSBackingStoreRetained
+						defer: YES];
+  [toolTip setLevel: NSPopUpMenuWindowLevel];
+  [toolTip orderFront: nil];
+  spin();
+  PASS_EQUAL(windowType(dpy, toolTip),
+    toolTipClass == [NSPanel class] ? @"DIALOG" : @"TOOLTIP DIALOG",
+    "a tool tip is a tool tip (a dialog for window managers that don't know it)");
+
+  /* A menu's window at the pop-up menu level, as a context menu's or a
+     pop-up button's is.  (No menu in it: a font looked up here can read a
+     font name the defaults have released, -[GSCInlineString copy]: message
+     sent to deallocated instance, and the test harness aborts on that.) */
+  menuWindow = [[NSClassFromString(@"NSMenuPanel") alloc]
+    initWithContentRect: NSMakeRect(0, 0, 100, 50)
+	      styleMask: NSBorderlessWindowMask
+		backing: NSBackingStoreBuffered
+		  defer: YES];
+  [menuWindow setLevel: NSPopUpMenuWindowLevel];
+  [menuWindow orderFront: nil];
+  spin();
+  PASS(menuWindow != nil
+    && [windowType(dpy, menuWindow) isEqual: @"POPUP_MENU DIALOG"],
+    "a context menu is a pop-up menu (a dialog for window managers that don't"
+    " know it)");
+  [menuWindow orderOut: nil];
+
+  modal = [[NSPanel alloc] initWithContentRect: NSMakeRect(100, 100, 300, 120)
+				     styleMask: NSBorderlessWindowMask
+				       backing: NSBackingStoreBuffered
+					 defer: NO];
+  [modal setLevel: NSModalPanelWindowLevel];
+  [modal orderFront: nil];
+  spin();
+  PASS_EQUAL(windowType(dpy, modal), @"DIALOG", "a modal panel is a dialog");
+
+  popUpLevel = [[NSWindow alloc] initWithContentRect: NSMakeRect(100, 100, 50, 50)
+					   styleMask: NSBorderlessWindowMask
+					     backing: NSBackingStoreBuffered
+					       defer: NO];
+  [popUpLevel setLevel: NSPopUpMenuWindowLevel];
+  [popUpLevel orderFront: nil];
+  spin();
+  PASS_EQUAL(windowType(dpy, popUpLevel), @"DIALOG",
+    "another window at the pop-up menu level stays a dialog");
+
+  [toolTip close];
+  [modal close];
+  [popUpLevel close];
+  stopWindowManager(wm);
+
+  END_SET("window types")
+  return 0;
+}
+
+#else
+
+int
+main(int argc, const char **argv)
+{
+  START_SET("window types")
+    SKIP("x11 backend only")
+  END_SET("window types")
+  return 0;
+}
+
+#endif
