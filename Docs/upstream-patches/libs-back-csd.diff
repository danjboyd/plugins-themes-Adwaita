+/*
+ * The offsets between the NSWindow frame and the X window: the window
+ * manager's decorations when it draws them (-styleoffsets:::::), else the
+ * shadow margin, which makes the X window larger than the frame.
+ */
+- (void) _offsets: (float *)l : (float *)r : (float *)t : (float *)b
+	      for: (gswindow_device_t *)win
+{
+  if (!handlesWindowDecorations)
+    {
+      *l = -win->shadow[0];
+      *r = -win->shadow[1];
+      *t = -win->shadow[2];
+      *b = -win->shadow[3];
+      return;
+    }
+  [self styleoffsets: l : r : t : b : win->win_attrs.window_style
+		    : win->ident];
+}
+
+/* The shadow margin, as GNOME's windows have it (libadwaita 1.7 measured
+ * under Mutter): the shadow reaches about 30 pixels out at the sides, and
+ * sits lower, so less at the top and more at the bottom.
+ */
+static const int shadowMargin[4] = { 30, 30, 24, 36 };
+
+/* How far outside the visible edge a resizable window takes presses, for
+ * resizing from the shadow (GTK 4 under Mutter: 12 pixels).
+ */
+static const int shadowResizeBand = 12;
+
+/*
+ * A 32-bit visual with an alpha channel, and a colormap for it, for windows
+ * with a shadow margin: the margin is transparent except for the shadow.
+ * (The screen context uses the default visual, which has no alpha.)
+ * NO when the display has none.
+ */
+static BOOL
+argb_visual(Display *dpy, int screen, Visual **visual, Colormap *cmap)
+{
+  static Visual *found = NULL;
+  static Colormap foundCmap = None;
+  static BOOL looked = NO;
+
+  if (!looked)
+    {
+#ifdef XRENDER
+      XVisualInfo templ, *vinfo;
+      int count, i;
+
+      templ.screen = screen;
+      templ.depth = 32;
+      templ.class = TrueColor;
+      vinfo = XGetVisualInfo(dpy, VisualScreenMask | VisualDepthMask
+			     | VisualClassMask, &templ, &count);
+      for (i = 0; vinfo != NULL && i < count && found == NULL; i++)
+	{
+	  XRenderPictFormat *format
+	    = XRenderFindVisualFormat(dpy, vinfo[i].visual);
+
+	  if (format != NULL && format->type == PictTypeDirect
+	    && format->direct.alphaMask)
+	    {
+	      found = vinfo[i].visual;
+	      foundCmap = XCreateColormap(dpy, RootWindow(dpy, screen),
+					  found, AllocNone);
+	    }
+	}
+      if (vinfo != NULL)
+	{
+	  XFree(vinfo);
+	}
+#endif
+      looked = YES;
+    }
+  *visual = found;
+  *cmap = foundCmap;
+  return found != NULL;
+}
